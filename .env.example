# All inference and storage remain local by default.
VEHICLE_SPECS_PDF_PATH="docs/sample-service-manual 1.pdf"
VEHICLE_SPECS_INDEX_PATH="artifacts/qdrant"
VEHICLE_SPECS_PAGES_PATH="artifacts/pages.jsonl"
VEHICLE_SPECS_CHUNKS_PATH="artifacts/chunks.jsonl"
VEHICLE_SPECS_PAGE_QUALITY_PATH="artifacts/page_quality.jsonl"
VEHICLE_SPECS_MODEL_CACHE_PATH="artifacts/models"
VEHICLE_SPECS_COLLECTION_NAME="vehicle_specs"

VEHICLE_SPECS_DENSE_MODEL="BAAI/bge-small-en-v1.5"
VEHICLE_SPECS_SPARSE_MODEL="Qdrant/bm25"
VEHICLE_SPECS_EMBEDDING_BATCH_SIZE=64

VEHICLE_SPECS_CHUNK_MAX_TOKENS=400
VEHICLE_SPECS_CHUNK_OVERLAP_TOKENS=40

VEHICLE_SPECS_RETRIEVAL_MODE="hybrid"
VEHICLE_SPECS_RETRIEVAL_CANDIDATE_K=20
VEHICLE_SPECS_RETRIEVAL_CONTEXT_K=8
VEHICLE_SPECS_RETRIEVAL_RRF_K=60
VEHICLE_SPECS_EXTRACTION_CONTEXT_K=5

VEHICLE_SPECS_RERANKER_MODEL="Xenova/ms-marco-MiniLM-L-6-v2"
VEHICLE_SPECS_RERANKER_BATCH_SIZE=32

# OpenAI-compatible inference client (the Compose defaults point to local vLLM).
VEHICLE_SPECS_LLM_MODEL="RedHatAI/Qwen3.5-4B-quantized.w4a16"
VEHICLE_SPECS_LLM_BASE_URL="http://localhost:8000/v1"
VEHICLE_SPECS_LLM_API_KEY="local-vllm"
VEHICLE_SPECS_LLM_MAX_OUTPUT_TOKENS=2048
VEHICLE_SPECS_LLM_REQUEST_TIMEOUT_SECONDS=180

# vLLM service settings for an 8 GB NVIDIA GPU.
VLLM_IMAGE="vllm/vllm-openai:v0.29.0"
VLLM_MODEL="RedHatAI/Qwen3.5-4B-quantized.w4a16"
VLLM_API_KEY="local-vllm"
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Local browser UI.
UI_PORT=8501
